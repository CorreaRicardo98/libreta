{
  "name": "libreta",
  "productName": "Libreta",
  "version": "1.4.0",
  "description": "Notas rápidas y organizadas, abiertas y locales. Para Windows y Linux.",
  "author": "Ricardo Correa Bautista (https://github.com/CorreaRicardo98)",
  "license": "MIT",
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env LIBRETA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "dist": "npm run build && electron-builder --linux AppImage deb --win nsis portable",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "electron-updater": "^6.8.9",
    "marked": "^18.1.1"
  },
  "build": {
    "appId": "io.github.correaricardo98.libreta",
    "productName": "Libreta",
    "copyright": "Ricardo Correa Bautista",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**",
      "dist-renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons",
      "maintainer": "Ricardo Correa Bautista <CorreaRicardo98@users.noreply.github.com>",
      "artifactName": "Libreta-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "3082",
      "artifactName": "Libreta-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CorreaRicardo98",
        "repo": "libreta",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}.${ext}",
    "portable": {
      "artifactName": "Libreta-${version}-portable.${ext}"
    },
    "deb": {
      "artifactName": "libreta_${version}_${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/CorreaRicardo98/libreta",
  "desktopName": "libreta.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorreaRicardo98/libreta.git"
  },
  "bugs": {
    "url": "https://github.com/CorreaRicardo98/libreta/issues"
  },
  "keywords": [
    "notas",
    "notes",
    "electron",
    "markdown",
    "local-first",
    "tiptap",
    "windows",
    "linux"
  ],
  "engines": {
    "node": ">=22.12"
  }
}